APP_NAME=candy-forecast-api
APP_ENV=local
APP_DEBUG=true
LOG_LEVEL=INFO

# Локальный Postgres (docker compose: порт 5432 на хосте). В контейнере api используйте хост `db`.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/candy_forecast

# In Docker override if needed:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/candy_forecast

SABY_AUTH_URL=https://online.sbis.ru/oauth/service/
SABY_API_BASE_URL=https://api.sbis.ru
# JSON-RPC (sabyWarehouse.List и др.): https://saby.ru/help/integration/api/all_methods/format
SABY_SERVICE_URL=https://online.sbis.ru/service/
# Скопируйте этот файл в `.env` и заполните один из вариантов ниже (см. README бэкенда).
SABY_APP_CLIENT_ID=
SABY_APP_SECRET=
SABY_SECRET_KEY=
# Либо готовый токен для локальных экспериментов:
# SABY_ACCESS_TOKEN=
