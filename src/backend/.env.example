APP_NAME=candy-forecast-api
APP_ENV=local
# Local dev: true; production: false
APP_DEBUG=true
LOG_LEVEL=INFO

# --- Authentication (set AUTH_ENABLED=true in production) ---
AUTH_ENABLED=false
# openssl rand -base64 32   OR: python -c "from src.backend.app.core.security import generate_secret_key; print(generate_secret_key())"
SESSION_SECRET=
SESSION_COOKIE_NAME=cf_session
SESSION_MAX_AGE_SECONDS=604800
# Behind HTTPS: SESSION_COOKIE_SECURE=true and often SESSION_COOKIE_SAMESITE=none for SPA on another origin
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Bcrypt hashes (never commit real passwords). Generate:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'my-password', bcrypt.gensalt()).decode())"
AUTH_ADMIN_USERNAME=
AUTH_ADMIN_PASSWORD_HASH=
# Optional read-only user (overview / sync status only)
AUTH_VIEWER_USERNAME=
AUTH_VIEWER_PASSWORD_HASH=

# OpenAPI / docs (disable in production if API is public-facing)
ENABLE_API_DOCS=true
ENABLE_OPENAPI_JSON=true

# Comma-separated origins for browser SPA (credentials cookies). Example:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://forecast.example.com
CORS_ALLOWED_ORIGINS=

# Saby debug proxy under /api/v1/saby/* (admin-only when AUTH_ENABLED). Disable in prod.
ENABLE_SABY_DEBUG_API=true

# Локальный Postgres (docker compose: порт 5432 на хосте). В контейнере api используйте хост `db`.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/candy_forecast

# Хранение загруженных через API бланков заказа (.xls). По умолчанию: <корень репо>/data/order_blanks
# ORDER_BLANK_STORAGE_DIR=/absolute/path/to/order_blanks

# In Docker override if needed:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/candy_forecast

SABY_AUTH_URL=https://online.sbis.ru/oauth/service/
SABY_API_BASE_URL=https://api.sbis.ru
# JSON-RPC (sabyWarehouse.List и др.): https://saby.ru/help/integration/api/all_methods/format
SABY_SERVICE_URL=https://online.sbis.ru/service/
# Скопируйте этот файл в `.env` и заполните один из вариантов ниже (см. README бэкенда).
SABY_APP_CLIENT_ID=
SABY_APP_SECRET=
SABY_SECRET_KEY=
# Либо готовый токен для локальных экспериментов:
# SABY_ACCESS_TOKEN=

# Продажи: сколько календарных месяцев тянуть и агрегировать (по умолчанию 3).
# SALES_MONTHS_BACK=3
